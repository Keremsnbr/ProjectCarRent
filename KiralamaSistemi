   public void addMoney(Kullanıcı EnteredPerson, Integer money) {
      if (money >= 0 && money <= 5000) {
         EnteredPerson.setBudget(EnteredPerson.getBudget() + money);
         PrintStream var10000 = System.out;
         String var10001 = String.valueOf(money);
         var10000.println(var10001 + " has been added to " + EnteredPerson.getName() + "'s Budget");
         System.out.println("Current Budget is : " + String.valueOf(EnteredPerson.getBudget()));
      } else {
         System.out.println("Invalid Amount");
      }

   }

